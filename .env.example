# Copy this file to ".env" (same folder) and fill in real values, then run:
#   npm run generate:samples
#
# ".env" is gitignored — it is NEVER committed. These are for LOCAL testing only.
# For PRODUCTION, set the same variables in the Netlify dashboard
# (Site configuration -> Environment variables), not in this file.

# --- Tier 1: required to generate sample audits (the quality gate) ---
OPENROUTER_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional: override the default model (anthropic/claude-sonnet-4.5)
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional: request tuning. Defaults are safe (150s timeout, 6000-token cap); a full Sonnet audit takes
# ~75s cold and ~3,700-3,900 output tokens. Raise the timeout on a slower host; raise max tokens only if
# you see a "truncated at max_tokens" error.
# OPENROUTER_TIMEOUT_MS=150000
# OPENROUTER_MAX_TOKENS=6000

# --- Needed only if you also want to test live email delivery locally ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=MapGap Report <reports@yourdomain.com>
OWNER_FALLBACK_EMAIL=

# --- Stripe (normally set in Netlify, not needed for local sample generation) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
